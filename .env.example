# Anomality server settings. Copy this file to .env and fill in your own values:
#   Copy-Item .env.example .env        (PowerShell)
# .env is ignored by git; never commit real keys. This template must stay free of secrets.
# Start the server with:  python -m uvicorn backend.app:app --port 8000 --env-file .env
# Format: NAME=value, no quotes, no spaces around "=". Leave a value empty to turn the feature off.

# --- AI Market Analyst (Gemini). Empty key = the analyst shows the backend's facts directly. ---
GEMINI_API_KEY=
# Model code from https://ai.google.dev/gemini-api/docs/models (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for Gemini (default: 20)
# ANALYST_TIMEOUT=20

# --- Voice reports (ElevenLabs). Both the key and the voice id are needed. ---
# The secret key starts with sk_ and is shown only when the key is created or rotated
# (not the key's ID from the list of keys).
ELEVENLABS_API_KEY=
# A voice from your ElevenLabs library: a stock or designed voice, not a clone of a real person.
ELEVENLABS_VOICE_ID=
# Model id (default: eleven_multilingual_v2)
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Seconds to wait for ElevenLabs (default: 30)
# VOICE_TIMEOUT=30

# --- Prices ---
# 1 = never call Yahoo Finance; use the saved prices (data/snapshot/), e.g. for a demo on bad Wi-Fi
# ANOMALITY_OFFLINE=1
